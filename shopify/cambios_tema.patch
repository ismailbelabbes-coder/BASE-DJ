@@ -290,6 +291,30 @@
           </div>
         </div>
       </div>
+      </template>
+      <script>
+        (function () {
+          // El menú del móvil se monta al abrirlo por primera vez: la página carga con muchos menos elementos.
+          var hd = document.currentScript.closest('header-drawer');
+          var tpl = document.getElementById('menu-drawer-tpl');
+          function montar() {
+            if (!tpl) return;
+            var box = document.getElementById('menu-drawer');
+            box.appendChild(tpl.content.cloneNode(true));
+            tpl.remove();
+            tpl = null;
+            box.querySelectorAll('summary').forEach(function (s) {
+              s.addEventListener('click', hd.onSummaryClick.bind(hd));
+            });
+            box
+              .querySelectorAll('button:not(.localization-selector):not(.country-selector__close-button):not(.country-filter__reset-button)')
+              .forEach(function (b) {
+                b.addEventListener('click', hd.onCloseButtonClick.bind(hd));
+              });
+          }
+          hd.addEventListener('click', function (e) { if (e.target.closest('summary')) montar(); }, true);
+        })();
+      </script>
     </div>
   </details>
 </header-drawer>
